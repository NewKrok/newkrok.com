<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,NE,R=301]
  RewriteCond %{REQUEST_FILENAME} -s [OR]
  RewriteCond %{REQUEST_FILENAME} -l [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^.*$ - [NC,L]
  RewriteRule ^(.*) /index.html [NC,L]
</IfModule>
<IfModule mod_headers.c>
  # The app shell must always be revalidated so new deploys show up at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Webpack output under /static/ has content hashes in its file names.
  <If "%{REQUEST_URI} =~ m#^/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Preview images and other media keep stable URLs, so cache them shorter.
  <If "%{REQUEST_URI} !~ m#^/static/# && %{REQUEST_URI} =~ m#\.(webp|png|jpe?g|gif|svg|ico|woff2?)$#">
    Header set Cache-Control "public, max-age=604800"
  </If>
</IfModule>
